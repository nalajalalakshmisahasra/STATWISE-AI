# App
NODE_ENV=development
# PORT=3000            # note: must be > 0; defaults to 3000
# APP_BASE_URL=http://localhost:3000

# Persistence — SQLite file created automatically if unset
# DATABASE_PATH=data/statwise.db

# Session signing secret. Set a strong random value for any non-local deployment.
# AUTH_SECRET=change-me-to-a-long-random-string

# AI provider (optional, SERVER-SIDE ONLY — never exposed to the browser)
# AI_PROVIDER=openai            # 'openai' (OpenAI-compatible chat completions) or 'anthropic'
# AI_API_KEY=                   # leave unset to use the clearly-labelled rules-based fallback
# AI_MODEL=gpt-4o-mini          # any chat model your provider key can access

# Government integrations — RESERVED / NOT USED in this build.
# Documented per PRD §8.4; flip to real adapters only with official authorization.
# IGOT_API_BASE_URL=
# IGOT_API_KEY=
# NSSTA_API_BASE_URL=
# NSSTA_API_KEY=
